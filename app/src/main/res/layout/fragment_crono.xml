<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/fondo_sector"
    tools:context=".ui.CronoFragment">

    <TextView
        android:id="@+id/hipercronoHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:drawablePadding="10dp"
        android:padding="20dp"
        android:text="@string/hipercrono"
        android:textColor="@color/white"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/fechaHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:text="@string/fecha_estelar_text" />

    <TextView
        android:id="@+id/fecha_estelar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="36sp"
        android:textColor="@color/green"
        android:text="@string/fecha_estelar" />


</LinearLayout>